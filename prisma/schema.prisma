// Portable schema: no enums or provider-specific column types, so switching
// from SQLite (local dev) to PostgreSQL (production) is a provider swap only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- contact form ----------

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String
  // sha256(ip + salt) — lets us rate limit without storing raw IPs
  ipHash    String
  userAgent String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

// ---------- projects (admin CRUD + GitHub sync) ----------

model Project {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  // short tech line shown under the title, e.g. "Python, Notion API"
  techLine    String
  description String
  repoUrl     String?
  liveUrl     String?
  sortOrder   Int     @default(0)
  published   Boolean @default(true)

  // populated by the GitHub sync job, never edited by hand
  ghStars     Int?
  ghForks     Int?
  ghLanguage  String?
  ghPushedAt  DateTime?
  ghSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

// ---------- NextAuth ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
