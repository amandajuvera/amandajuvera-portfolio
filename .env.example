# Local development. See README for switching to Neon Postgres in production.
DATABASE_URL="file:./dev.db"

# Salt for hashing visitor IPs before storing them (rate limiting).
# Generate your own for production: openssl rand -base64 32
IP_HASH_SALT=""

# NextAuth. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL for local dev: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Only this GitHub login may reach /admin.
ADMIN_GITHUB_LOGIN="amandajuvera"

# Optional: a GitHub personal access token (no scopes needed for public repos).
# Without it the sync job is limited to 60 requests/hour instead of 5000.
GITHUB_TOKEN=""

# Shared secret so only you can trigger the sync endpoint.
SYNC_SECRET=""
